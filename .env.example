# Copiá este archivo como .env y completalo. El .env NO se sube a git.
#
# ── En tu PC (servidor local) ─────────────────────────────────────────────
# Sin contraseña y solo accesible desde esta PC:
HOST=127.0.0.1
PORT=8091
# Para abrirla desde el celular en tu red de casa: HOST=0.0.0.0 (exige contraseña).

# ── En el VPS ─────────────────────────────────────────────────────────────
# HOST=127.0.0.1          ← la app escucha solo localmente; Caddy da la cara a internet
# DATA_DIR=/var/lib/matematica
# COOKIE_SECURE=1         ← cookie solo por HTTPS
# TRUST_PROXY=1           ← IP real desde Caddy (para el límite de intentos)
# REQUIRE_AUTH=1          ← contraseña obligatoria aunque HOST sea 127.0.0.1

# ── Contraseña ────────────────────────────────────────────────────────────
# NO lo escribas a mano: `npm run password` completa estas dos líneas.
# APP_PASSWORD_HASH=
# SESSION_SECRET=
