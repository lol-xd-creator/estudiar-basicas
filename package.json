{
  "name": "estudiar-matematica",
  "version": "0.1.0",
  "description": "Árbol de notas para estudiar matemática: fórmulas LaTeX, demostraciones paso a paso y gráficos 2D/3D.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=server.js --watch-path=src server.js",
    "password": "node scripts/password.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test"
  },
  "type": "module",
  "devDependencies": {
    "@mathjax/mathjax-pagella-font": "^4.1.3",
    "markdown-it": "^15.0.2",
    "mathjax": "^4.1.3",
    "pyodide": "^314.0.7"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
